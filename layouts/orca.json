{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.10"
  },
  "type": "column",
  "titlebar": "none",
  "traffic_lights": [12, 8],
  "background": "canvas",
  "terminal_padding": [14, 12],
  "preview": "layouts/orca.svg",
  "theme": "orca-dark",
  "terminal_menu": "orca-context-menu",
  "children": [
    {
      "id": "tabs",
      "type": "block",
      "size": {
        "px": 32
      },
      "window_drag": true,
      "content": {
        "mod": "orca-header",
        "props": {
          "motion": "native",
          "pinSidebarTerminal": true
        }
      }
    },
    {
      "id": "body",
      "type": "row",
      "floating": [
        {
          "id": "float-workspace",
          "content": {
            "mod": "orca-float-workspace"
          },
          "edge": "bottom",
          "align": "end"
        }
      ],
      "children": [
        {
          "id": "left",
          "type": "column",
          "resizable": false,
          "children": [
            {
              "id": "under",
              "type": "row",
              "children": [
                {
                  "id": "left-sidebar",
                  "type": "column",
                  "size": {
                    "px": 280
                  },
                  "min": 0,
                  "max": 500,
                  "background": "surface",
                  "resizable": false,
                  "children": [
                    {
                      "id": "nav",
                      "type": "column",
                      "resizable": false,
                      "children": [
                        {
                          "id": "nav-top",
                          "type": "block",
                          "content": {
                            "mod": "orca-sidebar-top"
                          },
                          "size": {
                            "px": 86
                          }
                        },
                        {
                          "id": "projects",
                          "type": "block",
                          "size": {
                            "weight": 1
                          },
                          "content": {
                            "mod": "orca-sidebar-projects"
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "work-body",
                  "type": "row",
                  "children": [
                    {
                      "id": "main",
                      "type": "stack",
                      "active": "main-terminals",
                      "children": [
                        {
                          "id": "main-terminals",
                          "type": "block",
                          "movable": false,
                          "content": {
                            "tab": "active",
                            "pane": {
                              "gap": 0,
                              "radius": 0,
                              "background": "background",
                              "lone": false,
                              "header": {
                                "content": {
                                  "mod": "orca-pane-header"
                                },
                                "height": 32,
                                "position": "top"
                              }
                            }
                          }
                        },
                        {
                          "id": "main-landing",
                          "type": "block",
                          "content": {
                            "mod": "orca-landing"
                          }
                        },
                        {
                          "id": "main-agents",
                          "type": "block",
                          "content": {
                            "mod": "orca-agent-settings"
                          }
                        },
                        {
                          "id": "main-providers",
                          "type": "block",
                          "content": {
                            "mod": "orca-agent-settings",
                            "props": {
                              "page": "providers"
                            }
                          }
                        },
                        {
                          "id": "main-tasks",
                          "type": "block",
                          "content": {
                            "mod": "orca-tasks"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "panel",
          "type": "column",
          "size": {
            "px": 350
          },
          "min": 0,
          "max": 900,
          "children": [
            {
              "id": "panel-head",
              "type": "block",
              "size": {
                "px": 31
              },
              "content": {
                "mod": "orca-right-sidebar-header"
              }
            },
            {
              "id": "panel-body",
              "type": "stack",
              "active": "files",
              "children": [
                {
                  "id": "files",
                  "type": "block",
                  "content": {
                    "mod": "orca-files"
                  }
                },
                {
                  "id": "agent-sessions",
                  "type": "block",
                  "content": {
                    "mod": "orca-right-sidebar-agents"
                  }
                },
                {
                  "id": "workspaces",
                  "type": "block",
                  "content": {
                    "mod": "orca-right-sidebar-placeholders",
                    "props": {
                      "tab": "workspaces"
                    }
                  }
                },
                {
                  "id": "pr-checks",
                  "type": "block",
                  "content": {
                    "mod": "orca-right-sidebar-placeholders",
                    "props": {
                      "tab": "pr-checks"
                    }
                  }
                },
                {
                  "id": "changes",
                  "type": "block",
                  "content": {
                    "mod": "orca-changes"
                  }
                },
                {
                  "id": "checks",
                  "type": "block",
                  "content": {
                    "mod": "orca-right-sidebar-placeholders",
                    "props": {
                      "tab": "checks"
                    }
                  }
                },
                {
                  "id": "ports",
                  "type": "block",
                  "content": {
                    "mod": "orca-right-sidebar-placeholders",
                    "props": {
                      "tab": "ports"
                    }
                  }
                }
              ],
              "size": {
                "weight": 1
              }
            }
          ],
          "background": "surface"
        }
      ]
    },
    {
      "id": "status",
      "type": "row",
      "size": {
        "px": 20
      },
      "gap": 0,
      "resizable": false,
      "children": [
        {
          "id": "status-footer",
          "type": "block",
          "size": {
            "weight": 1
          },
          "min": 121,
          "content": {
            "mod": "orca-status-footer"
          }
        },
        {
          "id": "status-bar",
          "type": "block",
          "size": {
            "weight": 12
          },
          "content": {
            "mod": "orca-status-bar"
          }
        },
        {
          "id": "status-ports",
          "type": "block",
          "size": {
            "px": 46
          },
          "content": {
            "mod": "orca-status-ports"
          }
        }
      ]
    }
  ]
}
